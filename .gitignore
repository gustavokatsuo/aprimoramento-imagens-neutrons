# Ficheiros de dados (Imagens, radiografias, etc.)
# O conteúdo não é versionado, mas a ESTRUTURA de pastas sim, via .gitkeep:
# 'data/' sozinho excluía o diretório inteiro e o git nem descia nele, então
# o '!data/.gitkeep' anterior nunca chegava a ser avaliado.
data/**
!data/**/
!data/**/.gitkeep

# Pesos do modelo PyTorch
*.pth
*.pt

# Ficheiros temporários do Jupyter Notebook / Colab
.ipynb_checkpoints/

# Ficheiros de cache do Python
__pycache__/
*.pyc
*.pyo

# Ambientes Virtuais (se usares no futuro)
venv/
env/
.env

# Ficheiros de sistema operativo
.DS_Store
Thumbs.db
